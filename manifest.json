{
  "manifest_version": 3,
  "name": "Ka - 网页转Markdown",
  "version": "1.0.0",
  "description": "一键把当前网页转换为 Markdown，支持编辑、复制、下载和批量转换",
  "permissions": [
    "activeTab",
    "contextMenus",
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "转换为 Markdown"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
